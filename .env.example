# ==========================================
# SENTINEL AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment (development / production)
ENVIRONMENT=development

# Database Configuration
# Local Zero-Setup Development Default:
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# Production PostgreSQL Example (Docker Compose / Cloud):
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinel

# Security & Authentication
# Generate a cryptographically secure key: openssl rand -hex 32
SECRET_KEY=sentinel-super-secret-development-key-change-in-production-32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional External AI Provider (OpenAI Compatible)
# If left blank, Sentinel AI operates using its built-in deterministic local evaluation engine
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_EVAL_MODEL=gpt-4o-mini

# Docker Compose Service Ports & Credentials
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_PORT=5432
REDIS_PORT=6379
